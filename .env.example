# Copy to .env at the repo root. Never commit .env, and never expose these to the browser.

# Required for real analysis. Create a key at https://dev.meta.ai
MODEL_API_KEY=

# Turns on /docs, /api/dev/usage and /api/session. Uncomment for local work. Leave it unset in production.
# QUACK_ENV=development

# Optional overrides, shown with their defaults.
# MODEL_API_BASE_URL=https://api.meta.ai/v1
# When deployed on a public name, QUACK_CORS_ORIGINS must list it, or posts from the app are refused.
# QUACK_CORS_ORIGINS=http://localhost:3000

# Model routing. Any purpose: transcribe, transcribe_confirm, hint, explain, voice_intent.
# QUACK_ROUTES={"transcribe": {"model": "muse-spark-1.3", "reasoning_effort": "low"}}
# QUACK_CONFIRM_ALERTS=true
# Both readings at once: faster alerts, and every check pays for two. False reads them in turn.
# QUACK_CONFIRM_IN_PARALLEL=true
# QUACK_SECOND_READING_ON_UNCERTAIN=false

# Start with inference disabled. Nonzero ceilings require verified available credit,
# durable accounting and explicit authorization for live calls; these are not free credits.
QUACK_BUDGET_PROJECT_USD=0
QUACK_BUDGET_SESSION_USD=0
QUACK_BUDGET_REQUEST_USD=0
QUACK_BUDGET_HOURLY_USD=0
# QUACK_RATE_LIMIT_PER_MINUTE=60
# QUACK_GLOBAL_RATE_LIMIT_PER_MINUTE=300

# Accounts. See docs/SETUP.md. Without a Supabase project, QUACK_ENV=development gives
# local test accounts, which aren't secure, and anything else has no accounts.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=
# Only needed for deleting a sign-in along with its account. Server only.
# SUPABASE_SERVICE_ROLE_KEY=
# Only for projects still signing tokens with a shared secret.
# SUPABASE_JWT_SECRET=
# Postgres connection string. Unset, accounts live in services/api/var/quack.db.
# QUACK_DATABASE_URL=
# Local SQLite alternative; requires a durable writable directory outside ephemeral serverless storage.
# QUACK_SQLITE_PATH=services/api/var/quack.db
# off, local or supabase. Unset, it follows from the above.
# QUACK_AUTH_MODE=

# When a reading is shown the student's own samples: off, on_doubt or always. See docs/SETUP.md.
# QUACK_PERSONALIZATION=on_doubt
# QUACK_REFERENCES_PER_READING=2

# The ledger behind the budgets. Keep it on a persistent disk, or a restart resets them.
# QUACK_LEDGER_PATH=services/api/var/usage.jsonl

# Where Next proxies /api/* is fixed when the app is built, and this file isn't read for it.
# Set it in the shell: API_URL=https://your-api npm run build
